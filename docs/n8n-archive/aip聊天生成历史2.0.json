    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\n// 收集纯文本片段\nconst parts = [];\nconst push = (txt) => {\n  const s = (txt ?? \"\").toString().trim();\n  if (s) parts.push(s);\n};\n\nfor (const item of allItems) {\n  const data = item?.json ?? item;\n  if (!data) continue;\n\n  // 1) 直接文本：{ output: \"...\" }\n  if (typeof data.output === \"string\") {\n    push(data.output);\n    continue;\n  }\n\n  // 2) 单条记录：{ title, content }（只取content）\n  if (typeof data.content === \"string\") {\n    push(data.content);\n    continue;\n  }\n\n  // 3) 数组记录：[{ title, content }, ...] 或 { rows: [...] } / { data: [...] }\n  const arr =\n    Array.isArray(data) ? data\n    : Array.isArray(data.rows) ? data.rows\n    : Array.isArray(data.data) ? data.data\n    : null;\n\n  if (arr) {\n    for (const row of arr) {\n      if (row && typeof row.content === \"string\") push(row.content);\n    }\n    continue;\n  }\n\n  // 4) 纯字符串 fallback\n  if (typeof data === \"string\") push(data);\n}\n\n// 仅输出 context\nreturn [{\n  json: {\n    context: parts.join(\"\\n\\n\"),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
