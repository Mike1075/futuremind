    {
      "parameters": {
        "jsCode": "const { messages = [], response, user } = items[0].json;\n\nfunction pickContent(m) {\n  if (!m) return \"\";\n  if (Array.isArray(m.parts)) return m.parts.map(p => (p?.text ?? p ?? \"\")).join(\"\");\n  return String(m.content ?? m.text ?? \"\").trim();\n}\n\nconst out = (Array.isArray(messages) ? messages : [])\n  .filter(m => [\"user\", \"assistant\"].includes(m.role))\n  .map(m => ({ isGaia: m.role === \"assistant\", content: pickContent(m) }));\n\nif (response) {\n  const last = out[out.length - 1]?.content ?? \"\";\n  if (String(last).trim() !== String(response).trim()) {\n    out.push({ isGaia: true, content: String(response).trim() });\n  }\n}\n\nif (user && (!out.length || out[0].isGaia || out[0].content !== String(user).trim())) {\n  out.unshift({ isGaia: false, content: String(user).trim() });\n}\n\n// 方案A：用对象包一层，Webhook用“Under Property=data”即可返回纯数组\nreturn [{ json: { data: out } }];\n"
      },
